pipeline{
    agent {label 'electronics'}

    environment {
        ECR_REPO='250063290505.dkr.ecr.eu-north-1.amazonaws.com/electronics-ecr'
        AWS_REGION = "eu-north-1"
        PRODUCTION_IP='16.171.93.167'
    }

    stages{

            stage('Build Docker Image'){
                steps{
                    dir("backend"){
                        sh 'sudo docker build -t electronics-backend:${BUILD_NUMBER} .'
                    }
                }
            }

            stage("Test ECR Login"){
                steps {
                    sh '''
                    aws ecr get-login-password --region ${AWS_REGION} | sudo Docker login --username AWS --password-stdin ${ECR_REPO}
                    '''
                }
            }

            stage ("Tag & Push to ECR"){
                steps{
                    sh '''
                    sudo Docker tag electronics-backend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}
                    sudo Docker tag electronics-backend:${BUILD_NUMBER} ${ECR_REPO}:latest
                    sudo Docker push ${ECR_REPO}:${BUILD_NUMBER}
                    sudo Docker push ${ECR_REPO}:latest

                    echo "Pushed Success ✅"
                    '''
                }
            }
}


  post {
    success{
        echo "ECR login success ✅"
    }

    failure {
        echo "ECR login Failed ❌"
    }
  }

}