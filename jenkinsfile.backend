pipeline{
    agent {label 'electronics'}

    environment {
        ECR_REPO='250063290505.dkr.ecr.eu-north-1.amazonaws.com/electronix-ecr'
        AWS_REGION = "eu-north-1"
    }

    stages{
        stage("Test ECR Login"){
            steps {
                sh '''
                aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REPO}
                '''
            }
        }
    }
 
  post {
    success{
        echo "ECR login success ✅"
    }

    failure {
        echo "ECR login Failed ❌"
    }
  }

}